{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure MSVC",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "msvc"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build MSVC Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "msvc-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure MSVC",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CTest: MSVC Debug",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "msvc-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: build MSVC Debug",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "CMake: configure MinGW Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "mingw-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build MinGW Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "mingw-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure MinGW Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "CTest: MinGW Debug",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "mingw-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: build MinGW Debug",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
